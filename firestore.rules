rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * True if `userId` refers to a real, active `users` doc with one of the
     * given roles. This is the strongest check achievable WITHOUT custom
     * auth claims: it doesn't prove the caller IS that user (see the
     * limitation note below), but it does prove the write is at least tied
     * to a real, currently-active staff account rather than a fabricated
     * id — closing the "any signed-in session can claim to be anyone"
     * gap for writes that carry an actor-identifying field.
     */
    function isActiveUserWithRole(userId, roles) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.active == true
        && get(/databases/$(database)/documents/users/$(userId)).data.role in roles;
    }

    // ---------------------------------------------------------------------
    // v1 LIMITATION (Phase 5 "finalize" pass — see 05_Data_Model.md §7 and
    // 06_Engineering_Plan.md §6, "PIN security is basic by design...
    // acceptable for v1, not meant for high-security multi-location use"):
    //
    // Auth is anonymous Firebase Auth per device; the actual identity
    // (worker vs owner) lives only in the `users` collection, matched
    // client-side by PIN hash. No custom auth claims are minted anywhere
    // in this stack (that would need a Cloud Function + Blaze billing —
    // flagged to the product owner, not added unprompted), so rules can
    // never fully PROVE which role the calling session belongs to.
    //
    // What CAN be done without new infra: for writes that carry a
    // client-supplied actor id (`orders.workerId`, which already exists in
    // the schema — Data Model §4), rules can at least verify that id
    // belongs to a real, active worker/owner via `isActiveUserWithRole()`
    // above. This is what `orders create` does below. A determined
    // attacker with API access could still discover a valid id (the
    // `users` collection is readable to any signed-in session, by
    // necessity — see below) and use it, but this eliminates fully
    // fabricated writes and ties every order to an identifiable, currently
    // -active account.
    //
    // What's still NOT enforceable without a schema or infra change:
    // `menu` writes and `orders` update/delete have no actor-identifying
    // field in the current Data Model to check against (menu docs don't
    // record who edited them; order corrections don't record who's
    // correcting them), so they remain `isSignedIn()`-gated only. Adding an
    // `updatedBy` field to `menu` (and a similar field for order
    // corrections) would let the same `isActiveUserWithRole()` pattern
    // apply there too — a scoped, no-new-infra follow-up if you want it,
    // but it's a small schema change so flagged here rather than made
    // silently.
    // ---------------------------------------------------------------------

    // users — PIN login must read this collection before any role is known
    // (chicken-and-egg), so any signed-in (incl. anonymous) session can
    // read. No client write path: users are provisioned via the Firebase
    // console or an admin script (Engineering Plan Phase 6), which uses
    // the Admin SDK and bypasses these rules entirely.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // menu — worker needs it for the order grid, owner needs it for
    // management, so read is any signed-in session. Write: see limitation
    // note above — not yet restrictable to role == owner without a schema
    // addition.
    match /menu/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // orders — read is any signed-in session (owner dashboard, worker
    // history). Create is hardened: workerId must reference a real, active
    // worker or owner. Update/delete (owner corrections) remain
    // isSignedIn()-only — see limitation note above.
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isActiveUserWithRole(request.resource.data.workerId, ['worker', 'owner']);
      allow update, delete: if isSignedIn();
    }
  }
}
